# Priority: process environment > .env > config.json > defaults
NDITOR_URL=http://127.0.0.1:3001
NDITOR_NYAITTER_URL=http://127.0.0.1:3000
NDITOR_TOKEN=

# Optional listen options (URL's explicit port is used otherwise).
# NDITOR_PORT=3001
# NDITOR_HOST=127.0.0.1
# NDITOR_WEB_ROOT=/absolute/path/to/build
# NDITOR_NYAITTER_API_PATH=/server

NDITOR_STORAGE_ADAPTER=local
NDITOR_STORAGE_ROOT=data/storage
NDITOR_STORAGE_QUOTA_MB=1024

# Explicit opt-in for a remote Nyaitter server without HTTPS:
# NDITOR_ALLOW_HTTP=true

# Cloudflare R2 optional settings:
# NDITOR_STORAGE_ADAPTER=r2
# NDITOR_R2_ACCOUNT_ID=
# NDITOR_R2_BUCKET=
# NDITOR_R2_ACCESS_KEY_ID=
# NDITOR_R2_SECRET_ACCESS_KEY=
# NDITOR_R2_PREFIX=nditor-private
