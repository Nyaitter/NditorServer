# Nditor's standalone editor/API listener
NDITOR_PORT=3001

# Nyaitter Server used for NyaitterAuth and public profile lookups
NDITOR_UPSTREAM=http://127.0.0.1:3000
NDITOR_NYAITTER_API_PATH=/server

# Store the key created by Nyaitter Server's `extension-key create` CLI outside Git.
NDITOR_EXTENSION_API_KEY_FILE=data/secrets/nyaitter-extension-api-key

# Nditor project snapshots use private storage owned by Nditor.
NDITOR_STORAGE_ADAPTER=local
NDITOR_STORAGE_ROOT=data/storage
NDITOR_STORAGE_QUOTA_MB=1024

# For Cloudflare R2, set NDITOR_STORAGE_ADAPTER=r2 and fill in a private bucket.
# NDITOR_R2_ACCOUNT_ID=
# NDITOR_R2_BUCKET=
# NDITOR_R2_ACCESS_KEY_ID=
# NDITOR_R2_SECRET_ACCESS_KEY=
# NDITOR_R2_PREFIX=nditor-private
